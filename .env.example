# Spiora demo — environment template
# Copy to .env.local and fill demo-only values. Never commit .env.local.

# ── Demo isolation (required for Spiora) ─────────────────────────────────────
SPIORA_DEMO_MODE=true
NEXT_PUBLIC_SPIORA_DEMO_MODE=true

# Integrations are OFF until explicitly enabled (see .env.spiora.example)
# SPIORA_ENABLE_SUPABASE=false
# SPIORA_ENABLE_GOOGLE_INTEGRATIONS=false
# SPIORA_ENABLE_EXTERNAL_AI=false
# SPIORA_ENABLE_LIVEKIT=false
# SPIORA_ENABLE_EMIGRANT_DESK=false
# SPIORA_ENABLE_CRON=false
# SPIORA_ENABLE_WEBHOOKS=false

# Blocklists — add production refs/IDs locally, never commit real values
# SPIORA_BLOCKED_SUPABASE_PROJECT_REFS=
# SPIORA_BLOCKED_GOOGLE_SPREADSHEET_IDS=
# SPIORA_BLOCKED_GOOGLE_DRIVE_FOLDER_IDS=
# SPIORA_BLOCKED_URL_SUBSTRINGS=
# SPIORA_ALLOWED_SUPABASE_PROJECT_REFS=

# ── Auth (required) ───────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

# Demo team passwords — set locally only
AUTH_PASSWORD_OWNER=
AUTH_PASSWORD_MANAGER_1=
AUTH_PASSWORD_MANAGER_2=
AUTH_PASSWORD_MANAGER_3=

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (optional — disabled in demo by default) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Emigrant Desk (optional — disabled in demo by default) ───────────────────
EMIGRANT_SUPABASE_URL=
EMIGRANT_SUPABASE_SERVICE_ROLE_KEY=

# ── LiveKit (optional — disabled in demo by default) ─────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_BUCKET=meeting-recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_REGION=eu-central-1

# ── Google Sheets / Drive (optional — disabled in demo by default) ───────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENTS_RANGE=Clients!A1:Z2000
GOOGLE_SHEETS_PUBLIC_CLIENTS_GID=
GOOGLE_SHEETS_FORMS_RANGE=Forms!A1:Z2000
GOOGLE_SHEETS_DOCUMENTS_RANGE=Documents!A1:Z2000
GOOGLE_SHEETS_NOTES_RANGE=Notes!A1:E5000
GOOGLE_SHEETS_CACHE_TTL_MS=10000
CRM_WRITE_ENABLED=false
CRM_WRITE_DRY_RUN=true
GOOGLE_DRIVE_KB_FOLDER_ID=
GOOGLE_DRIVE_EMIGRANT_FOLDER_ID=

# ── AI (optional — canned demo replies without external key) ─────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Spiora Demo
AI_WORKSPACE_MODEL=anthropic/claude-sonnet-4
AI_WORKSPACE_TEMPERATURE=0.4
AI_WORKSPACE_MAX_TOKENS=1500
AI_WORKSPACE_STREAM=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email (client invitations via Brevo REST) ─────────────────────────────────
# SPIORA_ENABLE_EMAIL=false
# BREVO_API_KEY=
# SPIORA_EMAIL_FROM="Spiora <info@spiora.ai>"

# Password self-service audit (requires migration 041 applied first)
# SPIORA_SECURITY_AUDIT_PASSWORD=false
# SPIORA_SECURITY_AUDIT_OAUTH=false
# SPIORA_SECURITY_AUDIT_AUTH=false
# AUTH=true enables both password + OAuth audit; PASSWORD/OAUTH enable subsets.
# SPIORA_AUDIT_HMAC_PEPPER=

# Supabase Auth recovery emails: configure Custom SMTP (Brevo SMTP key) in Dashboard.
# Redirect allowlist must include:
#   {NEXT_PUBLIC_APP_URL}/auth/confirm/employee
#   {NEXT_PUBLIC_APP_URL}/auth/confirm/client
# Recovery template:
#   <a href="{{ .RedirectTo }}?token_hash={{ .TokenHash }}&type=recovery">Reset password</a>
# redirectTo must be absolute URL with NO query string.

# ── Cron / webhooks (optional — disabled in demo by default) ─────────────────
SPIORA_CRON_TARGET_URL=
SPIORA_WEBHOOK_URL=
LIVEKIT_WEBHOOK_URL=
