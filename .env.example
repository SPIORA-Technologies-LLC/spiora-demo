# Northstar Mobility demo — environment template (no production values)

# Supabase — tasks, chat, AI history, calendar persistence
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional external desk integration (disabled in demo by default)
EMIGRANT_SUPABASE_URL=
EMIGRANT_SUPABASE_SERVICE_ROLE_KEY=

# Auth — required before any deployment
# Generate: openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

# LiveKit — internal video meetings (server only)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Meeting recordings (LiveKit Egress → Supabase Storage S3)
LIVEKIT_EGRESS_S3_ENDPOINT=
LIVEKIT_EGRESS_S3_BUCKET=meeting-recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
LIVEKIT_EGRESS_S3_REGION=eu-central-1

# Public app URL for guest meeting links (/join/...)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo team passwords — set locally, never commit real values
AUTH_PASSWORD_OWNER=
AUTH_PASSWORD_MANAGER_1=
AUTH_PASSWORD_MANAGER_2=
AUTH_PASSWORD_MANAGER_3=

# Google Sheets — CRM (leave empty to use built-in demo-data.ts)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENTS_RANGE=Clients!A1:Z2000
GOOGLE_SHEETS_PUBLIC_CLIENTS_GID=
GOOGLE_SHEETS_FORMGRID_SPREADSHEET_ID=
GOOGLE_SHEETS_FORMGRID_GID=0
GOOGLE_SHEETS_FORMS_RANGE=Forms!A1:Z2000
GOOGLE_SHEETS_DOCUMENTS_RANGE=Documents!A1:Z2000
GOOGLE_SHEETS_NOTES_RANGE=Notes!A1:E5000
GOOGLE_SHEETS_CACHE_TTL_MS=10000
CRM_WRITE_ENABLED=false
CRM_WRITE_DRY_RUN=true

# Google Drive — Knowledge Base (leave empty in demo)
GOOGLE_DRIVE_KB_FOLDER_ID=
GOOGLE_DRIVE_EMIGRANT_FOLDER_ID=

# AI — OpenRouter or OpenAI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=Northstar Mobility Demo

AI_WORKSPACE_MODEL=anthropic/claude-sonnet-4
AI_WORKSPACE_TEMPERATURE=0.4
AI_WORKSPACE_MAX_TOKENS=1500
AI_WORKSPACE_STREAM=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
