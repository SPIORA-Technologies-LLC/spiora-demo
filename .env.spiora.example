# Spiora — шаблон demo / production окружения
#
# Подробнее: SPIORA_LOCAL_ENV_SETUP.md, SPIORA_PRODUCTION_FOUNDATION_REPORT.md

# ═══════════════════════════════════════════════════════════════════════════════
# DEMO — МИНИМУМ (локальная демонстрация без внешних интеграций)
# ═══════════════════════════════════════════════════════════════════════════════

SPIORA_DEMO_MODE=true

AUTH_SECRET=replace-with-local-secret
CRON_SECRET=replace-with-local-cron-secret

AUTH_PASSWORD_OWNER=replace-me
AUTH_PASSWORD_MANAGER_1=replace-me
AUTH_PASSWORD_MANAGER_2=replace-me
AUTH_PASSWORD_MANAGER_3=replace-me

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Интеграции выключены — demo-data + .data fallback
SPIORA_ENABLE_SUPABASE=false
SPIORA_ENABLE_GOOGLE_INTEGRATIONS=false
SPIORA_ENABLE_EXTERNAL_AI=false
SPIORA_ENABLE_LIVEKIT=false
SPIORA_ENABLE_EMIGRANT_DESK=false
SPIORA_ENABLE_CRON=false
SPIORA_ENABLE_WEBHOOKS=false

# ═══════════════════════════════════════════════════════════════════════════════
# DEMO + POSTGRESQL CRM (рекомендуется после PR #13–#14)
# ═══════════════════════════════════════════════════════════════════════════════

# SPIORA_ENABLE_SUPABASE=true
# SPIORA_ALLOWED_SUPABASE_PROJECT_REFS=your-demo-ref-only
# NEXT_PUBLIC_SUPABASE_URL=https://your-demo-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-demo-service-role-key
# SUPABASE_ANON_KEY=          # не требуется — приложение использует service_role server-side

# SPIORA_CRM_LEGACY_FALLBACK=false   # только local dev; запрещён на Vercel

# ═══════════════════════════════════════════════════════════════════════════════
# PRODUCTION — дополнительные требования
# ═══════════════════════════════════════════════════════════════════════════════
#
# • AUTH_SECRET обязателен (без dev fallback)
# • SPIORA_DEMO_MODE=false или не задавать
# • Явно включать SPIORA_ENABLE_* per module
# • SPIORA_ALLOWED_SUPABASE_PROJECT_REFS — только production/demo project ref
# • Health check: GET /api/system/health (owner session)

# ═══════════════════════════════════════════════════════════════════════════════
# BLOCKLIST (локально, не коммитить production refs)
# ═══════════════════════════════════════════════════════════════════════════════

# SPIORA_BLOCKED_SUPABASE_PROJECT_REFS=old-prod-ref
# SPIORA_BLOCKED_GOOGLE_SPREADSHEET_IDS=old-spreadsheet-id
# SPIORA_BLOCKED_GOOGLE_DRIVE_FOLDER_IDS=old-folder-id
# SPIORA_BLOCKED_URL_SUBSTRINGS=old-deploy-hostname

# ═══════════════════════════════════════════════════════════════════════════════
# ОПЦИОНАЛЬНЫЕ ИНТЕГРАЦИИ (после отдельных demo-проектов)
# ═══════════════════════════════════════════════════════════════════════════════

# Google
# SPIORA_ENABLE_GOOGLE_INTEGRATIONS=true
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# External AI
# SPIORA_ENABLE_EXTERNAL_AI=true
# OPENROUTER_API_KEY=

# LiveKit
# SPIORA_ENABLE_LIVEKIT=true
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Email (client invitations via Brevo REST)
# SPIORA_ENABLE_EMAIL=true
# BREVO_API_KEY=
# SPIORA_EMAIL_FROM="Spiora <info@spiora.ai>"

# Password / OAuth / MFA audit (enable only after patches 041–044)
# SPIORA_SECURITY_AUDIT_PASSWORD=true
# SPIORA_SECURITY_AUDIT_OAUTH=false
# SPIORA_SECURITY_AUDIT_MFA=false
# SPIORA_SECURITY_AUDIT_AUTH=false
# AUTH enables password+OAuth+MFA; subset flags enable each area.
# SPIORA_AUDIT_HMAC_PEPPER=

# Employee TOTP MFA (Phase C) — keep false until SQL 043/044 + production smoke
# SPIORA_MFA_EMPLOYEE=false
# SPIORA_MFA_RECOVERY_PEPPER=

# Cron / webhooks
# SPIORA_ENABLE_CRON=true
# SPIORA_ENABLE_WEBHOOKS=true
# SPIORA_CRON_TARGET_URL=
