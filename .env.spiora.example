# Spiora — безопасный шаблон demo-окружения
#
# Этот файл описывает минимальную конфигурацию для локального demo Spiora
# без подключения к production-инфраструктуре оригинальной платформы.
#
# Как использовать:
#   1. cp .env.spiora.example .env.local   (или скопируйте вручную)
#   2. Заполните AUTH_SECRET, CRON_SECRET и пароли demo-команды
#   3. НЕ копируйте значения из старого .env.local production-копии
#
# Подробнее: SPIORA_LOCAL_ENV_SETUP.md

# ═══════════════════════════════════════════════════════════════════════════════
# ОБЯЗАТЕЛЬНО
# ═══════════════════════════════════════════════════════════════════════════════

SPIORA_DEMO_MODE=true

# Секреты сессии и cron (сгенерируйте локально):
#   openssl rand -base64 32
AUTH_SECRET=replace-with-local-secret
CRON_SECRET=replace-with-local-cron-secret

# Пароли demo-пользователей (см. src/lib/auth/users.ts):
AUTH_PASSWORD_OWNER=replace-me
AUTH_PASSWORD_MANAGER_1=replace-me
AUTH_PASSWORD_MANAGER_2=replace-me
AUTH_PASSWORD_MANAGER_3=replace-me

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════════
# ИНТЕГРАЦИИ — по умолчанию ВЫКЛЮЧЕНЫ
# ═══════════════════════════════════════════════════════════════════════════════
#
# Пока нет отдельного demo Supabase / Google / LiveKit проекта,
# оставьте все SPIORA_ENABLE_* = false (или не задавайте их).
#
# Приложение использует:
#   • встроенные demo-клиенты (src/lib/google-sheets/demo-data.ts)
#   • file-based fallback для задач/чата/календаря
#   • canned AI-ответы без внешних запросов

SPIORA_ENABLE_SUPABASE=false
SPIORA_ENABLE_GOOGLE_INTEGRATIONS=false
SPIORA_ENABLE_EXTERNAL_AI=false
SPIORA_ENABLE_LIVEKIT=false
SPIORA_ENABLE_EMIGRANT_DESK=false
SPIORA_ENABLE_CRON=false
SPIORA_ENABLE_WEBHOOKS=false

# ═══════════════════════════════════════════════════════════════════════════════
# ЗАЩИТА ОТ PRODUCTION (задайте локально, не коммитьте)
# ═══════════════════════════════════════════════════════════════════════════════
#
# Если у вас есть старые production ref/ID — добавьте их в blocklist,
# чтобы guard остановил запуск при случайном копировании .env:

# SPIORA_BLOCKED_SUPABASE_PROJECT_REFS=your-old-prod-ref
# SPIORA_BLOCKED_GOOGLE_SPREADSHEET_IDS=your-old-spreadsheet-id
# SPIORA_BLOCKED_GOOGLE_DRIVE_FOLDER_IDS=your-old-folder-id
# SPIORA_BLOCKED_URL_SUBSTRINGS=your-old-deploy-hostname

# Когда появится demo Supabase — whitelist только demo ref:
# SPIORA_ENABLE_SUPABASE=true
# SPIORA_ALLOWED_SUPABASE_PROJECT_REFS=your-demo-ref-only
# NEXT_PUBLIC_SUPABASE_URL=https://your-demo-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-demo-service-role-key
# Затем примените миграции (022_clients.sql) и seed (supabase/seeds/clients-demo.sql)

# Локальный fallback на legacy CRM (demo-data / Google) при ошибке PostgreSQL.
# Запрещён на Vercel. Не включайте в production.
# SPIORA_CRM_LEGACY_FALLBACK=false

# ═══════════════════════════════════════════════════════════════════════════════
# ОПЦИОНАЛЬНО — только после создания отдельных demo-проектов
# ═══════════════════════════════════════════════════════════════════════════════

# Supabase (demo project only)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Google (demo spreadsheet/folder only)
# SPIORA_ENABLE_GOOGLE_INTEGRATIONS=true
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# External AI (отдельный demo-ключ, не production)
# SPIORA_ENABLE_EXTERNAL_AI=true
# OPENROUTER_API_KEY=

# LiveKit (demo cluster only)
# SPIORA_ENABLE_LIVEKIT=true
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Cron / webhooks (demo deployment only)
# SPIORA_ENABLE_CRON=true
# SPIORA_ENABLE_WEBHOOKS=true
# SPIORA_CRON_TARGET_URL=https://your-demo-app.example/api/cron/calendar-reminders
